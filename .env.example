# Comma-separated tickers to watch
TICKERS=AAPL,MSFT,NVDA

# Free API key from https://finnhub.io (sign up, free tier is enough for hourly polling)
FINNHUB_API_KEY=

# Alert threshold — send an email if a stock moves this % or more from previous close
MOVE_THRESHOLD_PCT=2.0

# "Smarter" multi-day trend trigger — alerts on slower-building moves that a
# single-day check would miss (e.g. a steady 3-day climb that never has one
# big single-day jump). Uses our own stored hourly history, so it needs a
# few days of history to build up before it can find a comparison point.
MULTI_DAY_LOOKBACK_DAYS=3
MULTI_DAY_THRESHOLD_PCT=5.0

# SMTP settings for sending the alert email.
# If using Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords — use that as SMTP_PASSWORD, NOT your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
